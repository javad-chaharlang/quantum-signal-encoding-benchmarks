# Generated research artifacts
# Ignore generated outputs by default, but retain selected reproducible
# publication assets for validated experiments.

results/*
!results/.gitkeep
!results/audio/

# Basis-encoded reconstruction experiment
!results/audio/basis_encoded_audio/
!results/audio/basis_encoded_audio/README.md
!results/audio/basis_encoded_audio/experiment_report.json

# Controlled resource-scaling benchmark
!results/audio/resource_scaling/
!results/audio/resource_scaling/README.md
!results/audio/resource_scaling/resource_scaling.json
!results/audio/resource_scaling/resource_scaling_runs.csv
!results/audio/resource_scaling/resource_scaling_summary.csv

# Shot-sensitivity benchmark
!results/audio/shot_sensitivity/
!results/audio/shot_sensitivity/README.md
!results/audio/shot_sensitivity/shot_sensitivity.json
!results/audio/shot_sensitivity/shot_sensitivity_runs.csv
!results/audio/shot_sensitivity/shot_sensitivity_summary.csv

# Controlled synthetic-noise benchmark
!results/audio/noise_sensitivity/
!results/audio/noise_sensitivity/README.md
!results/audio/noise_sensitivity/noise_sensitivity.json
!results/audio/noise_sensitivity/noise_sensitivity_runs.csv
!results/audio/noise_sensitivity/noise_sensitivity_summary.csv

# Calibration-derived hardware-noise benchmark
!results/audio/hardware_noise/
!results/audio/hardware_noise/README.md
!results/audio/hardware_noise/backend_calibration.csv
!results/audio/hardware_noise/hardware_noise.json
!results/audio/hardware_noise/hardware_noise_layout_summary.csv
!results/audio/hardware_noise/hardware_noise_runs.csv
!results/audio/hardware_noise/hardware_noise_summary.csv

