*.py[cod]
*.so
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Linters and type checkers
.ruff_cache/
.mypy_cache/

